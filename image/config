# pi-gen config for the ShowPilot Player SD card image (arm64 branch).
# The login user is "showpilot"; set your own user, password, Wi-Fi and
# timezone with Raspberry Pi Imager's OS customisation when flashing.
IMG_NAME="ShowPilot-Player"
DEPLOY_COMPRESSION=xz
TARGET_HOSTNAME=showpilot
FIRST_USER_NAME=showpilot
FIRST_USER_PASS=showpilot
DISABLE_FIRST_BOOT_USER_RENAME=1
ENABLE_SSH=1
LOCALE_DEFAULT=en_US.UTF-8
KEYBOARD_KEYMAP=us
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT=America/Chicago
STAGE_LIST="stage0 stage1 stage2 stage-showpilot"
